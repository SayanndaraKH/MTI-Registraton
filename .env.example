# App Configuration
APP_NAME="Cambodian Course KHQR Sales Automation"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database
DATABASE_URL="sqlite:///./course_sales.db"

# First Admin account, created automatically on first startup only.
# Changing it later does NOT overwrite the password - use the dashboard for that.
ADMIN_USERNAME="ADMIN"
ADMIN_PASSWORD="syd@168"

# Signs the login session cookie. Generate your own; changing it logs everyone out.
SECRET_KEY="generate-a-random-32-byte-base64-string"

# Disable self registration so only ADMIN and predefined users can log in
ALLOW_SELF_REGISTER=False

# KHQR payment image is uploaded via the Admin Dashboard (not set here)
KHQR_IMAGE_URL=""

# Telegram links shown to students at checkout
TELEGRAM_CONTACT_LINK="https://t.me/your_telegram_username"
TELEGRAM_GROUP_LINK="https://t.me/+demo_course_group"

# Support contact phone number
CONTACT_PHONE="012 345 678"
